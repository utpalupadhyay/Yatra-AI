# Root .gitignore for Yatra AI
# ------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables (NEVER commit — contains API keys!)
.env
.env.local
.env.production
.env*.local
*.env

# IDE / editor
.idea/
.vscode/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Build / dist
build/
dist/
*.egg-info/

# Logs
*.log

# Temp files
*.tmp
*.bak

# Jupyter
.ipynb_checkpoints/
