# Yatra AI — Environment Variables
# NEVER share this file or commit it to git.

# ── Gemma 4 API Key (required) ────────────────
# YOUR KEY GOES HERE — keep this file private!
GEMMA_API_KEY=YOUR_NEW_KEY_HERE

# ── Model Configuration ───────────────────────
GEMMA_MODEL=gemma-4-31b-it
GEMMA_MODEL_FALLBACK=gemma-4-26b-a4b-it

# ── App Settings ──────────────────────────────
DEBUG=False
APP_VERSION=1.0.0
